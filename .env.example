# INSTRUCTIONS:
#   1. Copy this file and rename it to: .env
#      (Command: copy .env.example .env)
#   2. Fill in the values below
#   3. NEVER commit the actual .env file — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# API Base URL — change to production URL when deploying
VITE_API_BASE_URL=https://dev-int.ismart.org/api/v1
